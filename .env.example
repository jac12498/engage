# ── Database (shared Supabase, isolated in the `engagecampaign` schema) ──
# Pooled connection used at runtime. The multiSchema Prisma setup schema-qualifies
# every query, so no ?schema= param is needed here.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=5"
# Direct connection for migrations/DDL tooling; carries the schema param.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=engagecampaign"

# ── Email (Resend magic-link auth) ──
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
# Transactional sender (magic links). Verified Resend domain — keep separate from the
# bulk newsletter sender (news.engageamplify.com) to isolate reputation.
EMAIL_FROM="Engage <noreply@mail.engageamplify.com>"

# ── NextAuth (Auth.js v5) ──
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-32-byte-base64-string"
# Canonical app URL — set to the production URL when deployed.
AUTH_URL="http://localhost:3000"
# Public base URL for marketing sitemap/robots (absolute URLs). Prod: https://engageamplify.com
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Newsletter sending (Resend bulk) ──
# Bulk newsletter sender; defaults to news@news.engageamplify.com if unset.
NEWSLETTER_FROM_ADDRESS="news@news.engageamplify.com"
# Svix signing secret for the Resend bounce/complaint webhook (/api/webhooks/resend).
# From Resend → Webhooks after you create the endpoint.
RESEND_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxxxxxx"

# ── Anthropic (AI generation) ──
ANTHROPIC_API_KEY="sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx"

# ── Google Maps (contact address autocomplete; optional) ──
# Enable "Maps JavaScript API" + "Places API" on the key's Google Cloud project.
# Without it, address fields still work as plain text (no autocomplete).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
