# dependencies
/node_modules
/.pnp
.pnp.*

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# campaign-finance data: commit the small committee registry parquet (queried at
# runtime), but keep raw source CSVs and large future datasets out of git.
# Large parquets (disclosures, donor geocodes) go on a Railway volume at the same
# data/campaign_finance/{state}/ path.
/data/campaign_finance/**/COMMCAND*.CSV
/data/campaign_finance/**/*.csv
# Ignore the big disclosures parquet, but keep small tracked docs (schema.json,
# README) in the disclosures/ folder version-controlled.
/data/campaign_finance/**/disclosures/*.parquet
/data/campaign_finance/**/*donor_geocodes*
/data/campaign_finance/**/*.duckdb
# FEC (federal) bulk data + built parquets are huge — keep them out of git (built
# offline via `npm run finance:generate-fec`, served from a Railway volume in prod).
# Small tracked docs (schema.json, README) in fec/ stay version-controlled.
/data/campaign_finance/fec/*.zip
/data/campaign_finance/fec/*.parquet
/data/campaign_finance/fec/*.txt
/data/campaign_finance/fec/_*/
# NY voter file: the source CSV (6+ GB, PII) and built parquets are huge — built
# offline via `npm run voters:convert-ny`, served from a Railway volume in prod.
# Small tracked docs (schema.json, election_mappings.json, README) stay in git.
/data/voter_records/**/*.csv
/data/voter_records/**/*.parquet
/data/voter_records/**/unmapped_election_codes.json
