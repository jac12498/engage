// EngageCampaign data layer.
//
// IMPORTANT: every model is bound to the `engagecampaign` Postgres schema via
// `@@schema`. This app shares the Supabase database with the existing Engage app
// (version10.3, which owns `public`), so isolation is the safety boundary —
// EngageCampaign's Prisma never references or migrates anything in `public`.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["engagecampaign"]
}

// ─── NextAuth ────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]

  // A user belongs to one or more committees, each with a role (see
  // CommitteeMembership). Replaces the old 1:1 User↔Campaign relation.
  memberships   CommitteeMembership[]

  // Persisted active context, so a committee/candidate/campaign switch survives
  // across devices and re-logins. The JWT mirrors these; the switchers write them.
  lastCommitteeId String?
  lastCandidateId String? // active Candidate (the person)
  lastCampaignId  String? // active Campaign (the run under that candidate)

  // Most recent release-notes version this user has viewed (drives the "What's
  // new" unseen-dot in the sidebar). Null until they open Release notes once.
  lastSeenReleaseVersion String?

  // Overall System Administrator (global, cross-committee). Grants the /admin
  // area and the ability to impersonate any member. Seeded, never self-granted.
  isSystemAdmin Boolean @default(false)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@schema("engagecampaign")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@schema("engagecampaign")
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("engagecampaign")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@schema("engagecampaign")
}

// ─── Committee (account / tenant / billing entity) ───────────────────────────

// A committee is the account. It owns one or more Campaigns (candidate races),
// has one or more members (users with a role), and holds the subscription plan
// and shared usage metering pool. This is the multi-tenant boundary: everything
// a signed-in user does happens within an "active committee" they belong to.
model Committee {
  id   String @id @default(cuid())
  name String

  // Registration profile. `jurisdiction` ("state" | "federal") says which body a
  // committee registers under — they're distinct regimes and a federal contribution
  // never matches a state committee id (and vice-versa). `filerId` is the recipient
  // id in that jurisdiction: a state BOE filer ID (state committees) or an FEC
  // committee id "C00…" (federal). For state committees `state` (2-letter) drives
  // which committee types are offered + coverage, and `committeeType` is a code from
  // the state's list (see lib/committeeTypes.ts — e.g. "constituted", "pac"); federal
  // committees leave `state`/`committeeType` null. All nullable (legacy backfilled
  // committees have none); jurisdiction defaults to "state".
  jurisdiction  String  @default("state")
  state         String?
  committeeType String?
  filerId       String?

  // Registry sync (NYSBOE), set by the admin Data Import reconciliation. Lets us
  // flag an in-use committee (one with a filerId) that became terminated or whose
  // details (treasurer, address, name) changed. Informational only - never gates
  // access. `registryAlert` drives a dismissible owner banner.
  registryStatus   String? // ACTIVE | TERMINATED | SUSPENDED | MISSING | ...
  registrySnapshot Json? //   { name, committeeType, treasurer, addressLine1, city, addressState, zip }
  registrySyncedAt DateTime?
  registryAlert    String? // "terminated" | "changed" | null

  // Committee assets — reusable brand elements at the committee level (parallel to a
  // candidate's assets). Logo stored in-DB, served via /api/committee/logo/[committeeId].
  logoData   Bytes?
  logoMime   String?
  actblueUrl String? // committee ActBlue / donate link
  websiteUrl String? // committee's external/website link

  // Committee mailing address (postal). Used for disclaimers/newsletters at the org level.
  mailingStreet  String?
  mailingStreet2 String?
  mailingCity    String?
  mailingState   String?
  mailingZip     String?

  members   CommitteeMembership[]
  candidates Candidate[]
  contacts  Contact[]
  newsletterSubscribers NewsletterSubscriber[] // committee-wide newsletter list (2b-1)
  site      Website? // one committee website (2b-2)
  roleTypes RoleType[] // committee-scoped custom roles (module-based access)

  // Entitlement: which plan this account is on. Default free tier = Starter.
  plan String @default("starter") // starter | campaign | committee

  // AI Communications — shared usage pool across all this committee's campaigns.
  aiModel                   String? // preferred generation model; null = default Haiku
  creditsThisMonth          Int      @default(0) // Model Credits consumed this month
  revisionsThisMonth        Int      @default(0) // every 5th revision charges the model's credit cost
  crawlsThisMonth           Int      @default(0) // website-crawl references this month
  websiteEditsThisMonth     Int      @default(0) // conversational website-builder messages this month
  newsSearchesThisMonth     Int      @default(0) // "In the News" web-search discovery runs this month
  newsletterEmailsThisMonth Int      @default(0) // newsletter recipient-emails sent this month
  billingPeriodStart        DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("engagecampaign")
}

// User ↔ Committee join with a role that governs privileges. Roles (ranked):
// owner > admin > editor > viewer.
//   owner  — billing, delete committee, manage members (incl. other owners)
//   admin  — manage members + all content
//   editor — create/edit content (comms, contacts, website); no member/billing control
//   viewer — read-only
model CommitteeMembership {
  userId      String
  committeeId String
  // Legacy coarse role (owner|admin|editor|viewer) — kept during the RBAC
  // transition as a fallback and dropped in a later contract migration.
  role        String
  // The assigned RoleType (privilege bundle). Backfilled from `role`. Nullable
  // until the seed runs; permission resolution falls back to `role` meanwhile.
  roleTypeId  String?
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  committee Committee @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  roleType  RoleType? @relation(fields: [roleTypeId], references: [id], onDelete: SetNull)

  @@id([userId, committeeId])
  @@index([committeeId])
  @@index([roleTypeId])
  @@schema("engagecampaign")
}

// ─── RBAC: privileges (per-module CRUD) → roles → memberships ─────────────────
// See src/lib/permissions.ts for the privilege vocabulary these tables mirror.

// A single privilege, e.g. key "contacts:update" (module "contacts", action "update").
model Permission {
  id     String @id @default(cuid())
  key    String @unique
  module String
  action String

  roles RolePermission[]

  @@schema("engagecampaign")
}

// A named privilege bundle. Global built-ins (committeeId null): Committee
// Administrator, Member, Viewer. Committee-scoped rows are custom module-based
// roles an admin builds.
model RoleType {
  id          String  @id @default(cuid())
  key         String
  label       String
  description String?
  isBuiltIn   Boolean @default(false)
  committeeId String? // null = global built-in; set = committee custom role

  committee   Committee?            @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  memberships CommitteeMembership[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([committeeId, key])
  @@index([committeeId])
  @@schema("engagecampaign")
}

model RolePermission {
  roleTypeId   String
  permissionId String

  roleType   RoleType   @relation(fields: [roleTypeId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleTypeId, permissionId])
  @@index([permissionId])
  @@schema("engagecampaign")
}

// ─── Campaign (candidate race profile) ───────────────────────────────────────

model Candidate {
  id          String    @id @default(cuid())
  committeeId String
  committee   Committee @relation(fields: [committeeId], references: [id], onDelete: Cascade)

  // The person — durable identity across runs (Campaigns).
  candidateName String

  // Candidate headshot — the person's photo, stored in-DB. Served via
  // /api/website/headshot/[candidateId].
  headshotData Bytes?
  headshotMime String?

  // Candidate logo — an optional campaign logo image, stored in-DB. Served via
  // /api/candidate/logo/[candidateId]. Part of the candidate's reusable assets.
  logoData Bytes?
  logoMime String?

  bio           String? @db.Text
  tagline       String? // the campaign slogan (surfaced as "Slogan" in Candidate assets)
  website       String? // the candidate's external/website link
  actblueUrl    String? // the candidate's ActBlue / donate link

  // Candidate knowledge — gathered via the guided interview. The richer this is,
  // the better-grounded every generated communication (and, later, the website).
  education          String? @db.Text
  experience         String? @db.Text
  whyRunning         String? @db.Text
  coreValues         String? @db.Text
  politicalLean      String? @db.Text // short narrative summary of the candidate's lean/positions
  voiceTone          String? // preferred tone, e.g. "warm and plainspoken"
  interview          Json? // raw structured interview answers (e.g. the lean questionnaire)
  interviewUpdatedAt DateTime?

  // Runs for office — one Campaign per cycle. Per-race content (communications, news,
  // newsletter issues) and the run profile (office, ballot line, district, "Paid for
  // by") live on the Campaign.
  campaigns Campaign[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([committeeId])
  @@schema("engagecampaign")
}

// ─── Campaign (one run for office in a cycle) ────────────────────────────────
// A candidate's run in a specific cycle (e.g. Jeff Collins 2026). Owns that race's
// outputs — communications, news, newsletter issues — and the run-specific profile,
// so a candidate can run for different offices/lines over time.
model Campaign {
  id          String    @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  cycle Int // election year, e.g. 2026

  // Run profile (powers AI Communications + the "Paid for by" disclaimer)
  office            String
  party             String? // primary ballot line (required in the UI)
  additionalParties String[] @default([]) // fusion endorsements alongside the primary line
  committeeName     String? // registered campaign committee — the legal "Paid for by"
  filerId           String? // the candidate's own committee filer id (state BOE) — scopes donor import

  // Physical postal address — required in every newsletter footer (CAN-SPAM).
  mailingAddress String?
  mailingStreet  String?
  mailingStreet2 String?
  mailingCity    String?
  mailingState   String?
  mailingZip     String?

  // Per-run newsletter template (header/footer/theme across this run's issues).
  newsletterTemplate Json?

  // District link — the bridge to voter records (snapshot of public.districts; the
  // queryString filters this run's voters from the voter parquet via DuckDB).
  state               String?
  district            String?
  districtId          String?
  districtQueryString String?
  districtVoterCount  Int?

  // Per-race outputs.
  topics            Topic[]
  generations       Generation[]
  contextItems      ContextItem[]
  newsClips         NewsClip[]
  newsletters       Newsletter[]
  newsletterImages  NewsletterImage[]
  newsletterPresets NewsletterPreset[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([candidateId])
  @@schema("engagecampaign")
}

// ─── AI Communications ───────────────────────────────────────────────────────

// A saved AI-generated communication. Ported from the archived Amplify app and
// extended with `model` (which AI model produced it) and `newsItemId` (the news
// item used to ground it, if any).
model Generation {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  // Content format (e.g. speech, email, social_facebook, press_release …) and
  // the medium it belongs to (speeches | letters | social | print).
  type       String
  medium     String? // grouping for the media sub-pages
  title      String?
  topicId    String? // optional Topic this piece is about
  topic      Topic?  @relation(fields: [topicId], references: [id], onDelete: SetNull)
  issueId    String? // optional Issue used as the topic
  newsItemId String? // optional NewsItem used as grounding
  newsHook   String? // freeform topic / hook when no Topic is selected
  model      String // AI model used, e.g. claude-haiku-4-5
  prompt     String  @db.Text
  content    String  @db.Text // current (latest) version's content
  published  Boolean @default(false)

  versions GenerationVersion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId])
  @@index([topicId])
  @@schema("engagecampaign")
}

// One version in a generation's refine history. v1 = the original draft
// (revisionNote null); each subsequent version records the note that produced
// it, so the human↔AI collaboration is captured and browsable.
model GenerationVersion {
  id           String     @id @default(cuid())
  generationId String
  generation   Generation @relation(fields: [generationId], references: [id], onDelete: Cascade)
  versionNo    Int
  content      String     @db.Text
  revisionNote String?    @db.Text
  model        String
  createdAt    DateTime   @default(now())

  @@index([generationId])
  @@schema("engagecampaign")
}

// A "hot topic" — a specific subject to communicate about. Mirrors v10.3's
// CommunicationsTopic: a key message + audience + occasion + talking points that
// a generation targets (distinct from the candidate's standing Issue positions).
model Topic {
  id             String       @id @default(cuid())
  campaignId     String
  campaign       Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  title          String
  keyMessage     String?       @db.Text
  targetAudience String?
  occasion       String?
  talkingPoints  String[] // ordered by priority (most → least important)
  generations    Generation[]
  contextItems   ContextItem[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([campaignId])
  @@schema("engagecampaign")
}

// Every piece of grounding is a ContextItem. Two orthogonal dimensions:
//   type  — "note" (plain background) | "position" (stance + keyPoints) |
//           "reference" (press/article with url + source)
//   scope — topicId null → GENERAL (every generation); topicId set → only when
//           that Topic is used (mirrors v10.3's CampaignIntelligence.commTopicId).
// Auto-injected by scope: general items + the selected topic's items.
model ContextItem {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  topicId    String?
  topic      Topic?   @relation(fields: [topicId], references: [id], onDelete: Cascade)

  type      String   @default("note")
  title     String? // position: issue name; reference: headline; note: optional label
  body      String   @db.Text // position: the stance; reference: summary; note: the text
  keyPoints String[] // positions only (ordered talking points)
  url       String? // references only
  source    String? // references only
  refType   String? // references only: "webpage" | "document" (PDF)
  order     Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId])
  @@index([topicId])
  @@schema("engagecampaign")
}

// ─── Committee Website ───────────────────────────────────────────────────────

// One published-or-draft website per COMMITTEE (2b-2). A single-candidate committee's
// site features that candidate; a party/multi committee's site is a party landing with
// a candidates section + per-candidate profile pages. Content is auto-drafted via Claude,
// then editable (Page/Block). Public route: /websites/<committeeId> (+ /candidate/<id>).
model Website {
  id          String    @id @default(cuid())
  committeeId String    @unique
  committee   Committee @relation(fields: [committeeId], references: [id], onDelete: Cascade)

  // Committee-level site identity (default to the committee name).
  siteTitle String? // shown in the header / browser title
  paidForBy String? // the legal "Paid for by" line in the footer

  slug      String  @unique // public path segment
  published Boolean @default(false)

  // Theme
  primaryColor String  @default("#1b3a6b")
  accentColor  String  @default("#c4910a")
  fontTheme    String  @default("classic") // named preset: classic | modern | serif
  headshotData Bytes?  // optional committee logo, stored in-DB (served via the headshot route)
  headshotMime String? // content-type of the uploaded logo — null = none

  // Calls to action
  donateUrl    String? // external ActBlue / WinRed / Anedot link (no payment processing here)
  contactEmail String?

  pages   Page[]
  signups VolunteerSignup[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("engagecampaign")
}

// ─── Page/Block content model (Phase 1) ──────────────────────────────────────
// A Website has many Pages; a Page has an ordered list of Blocks. Each Block is
// one of a closed vocabulary of types (see src/lib/website/blocks.ts) with a
// validated `props` JSON payload. Rendering, the editor palette, and the Phase 2
// AI builder all read that single block registry. See docs/website-phase1-spec.md.
model Page {
  id        String  @id @default(cuid())
  websiteId String
  website   Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  slug      String // path segment; the isHome page is served at the site root. Unique per website.
  title     String // nav label + <title>
  navOrder  Int     @default(0)
  showInNav Boolean @default(true)
  published Boolean @default(true) // draft a page without unpublishing the whole site
  isHome    Boolean @default(false) // exactly one per site; undeletable; served at root

  blocks Block[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([websiteId, slug])
  @@index([websiteId])
  @@schema("engagecampaign")
}

model Block {
  id     String @id @default(cuid())
  pageId String
  page   Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)

  type  String // one of the v1 vocabulary; validated on write
  order Int    @default(0)
  props Json   // typed, validated per-type payload (BLOCK_SPECS[type].validate)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pageId])
  @@schema("engagecampaign")
}

// Raw intake from the public website volunteer form. Acts as a moderation queue:
// signups arrive `pending`, then a reviewer Accepts (promotes to a Contact) or
// Rejects. Kept separate from Contact so unauthenticated/spam input never lands
// directly in the CRM.
model VolunteerSignup {
  id        String  @id @default(cuid())
  websiteId String
  website   Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  name      String
  email     String
  phone     String?
  message   String? @db.Text
  createdAt DateTime @default(now())

  // Review workflow
  status     String    @default("pending") // pending | accepted | rejected
  reviewedAt DateTime?
  contactId  String? // the Contact created/linked when accepted
  contact    Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([websiteId])
  @@index([websiteId, status])
  @@index([contactId])
  @@schema("engagecampaign")
}

// Press coverage ("In the News") about the candidate. Discovered via Claude web
// search — or added by URL — then curated: clips arrive `pending`, and a reviewer
// Approves (surfaces on the site's `pressMentions` block) or Rejects. External
// articles are NEVER auto-published: the review step guards against false-positive
// (wrong person / same name) or off-message hits.
model NewsClip {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  headline    String
  url         String
  outlet      String? // publication name, when known
  summary     String?   @db.Text // 1–2 sentence blurb
  publishedAt DateTime? // article date, when known
  source      String    @default("web_search") // web_search | manual

  status     String    @default("pending") // pending | approved | rejected
  reviewedAt DateTime?

  createdAt DateTime @default(now())

  @@unique([campaignId, url]) // dedupe repeat discovery of the same article
  @@index([campaignId, status])
  @@schema("engagecampaign")
}

// ─── Newsletter ──────────────────────────────────────────────────────────────

// A subscriber to the campaign's periodic newsletter. Public signup uses double
// opt-in: a signup arrives `pending` with a confirmToken; clicking the emailed
// link flips it to `active`. Every subscriber carries a permanent unsubscribeToken
// used in the footer of each newsletter (CAN-SPAM one-click unsubscribe). Only
// `active` subscribers are mailed. Kept separate from Contact (a lightweight,
// compliance-bearing mailing list), though active subscribers may also be surfaced
// as Contacts later.
model NewsletterSubscriber {
  id          String    @id @default(cuid())
  committeeId String
  committee   Committee @relation(fields: [committeeId], references: [id], onDelete: Cascade)

  email  String
  name   String?
  status String @default("pending") // pending | active | unsubscribed
  source String @default("website")

  confirmToken     String? @unique // double opt-in; cleared once confirmed
  unsubscribeToken String  @unique // permanent; embedded in every send

  createdAt      DateTime  @default(now())
  confirmedAt    DateTime?
  unsubscribedAt DateTime?

  @@unique([committeeId, email])
  @@index([committeeId, status])
  @@schema("engagecampaign")
}

// An uploaded image used in a newsletter image block. Stored in-DB and served at a
// stable public URL (/api/newsletter/image/[id]) so email clients can fetch it.
model NewsletterImage {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  data       Bytes
  mime       String
  createdAt  DateTime @default(now())

  @@index([campaignId])
  @@schema("engagecampaign")
}

// A saved newsletter preset — a full starting point bundling branding (theme/
// header/footer) + a starting block layout. Users start a new issue from one, or
// "save as template" from any issue. Built-in presets live in lib/newsletter/presets.ts.
model NewsletterPreset {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  name     String
  template Json // branding: { theme, header, footer }
  blocks   Json // starting content blocks [{ id, type, props }]

  createdAt DateTime @default(now())

  @@index([campaignId])
  @@schema("engagecampaign")
}

// One issue of the campaign's newsletter. Authored (optionally AI-drafted) in the
// newsletter manager, published to the public archive, and — in Phase 3 — emailed to
// active subscribers. `body` is plain text (blank lines = paragraphs) so it renders
// safely in both the web archive and email. Dedicated model (not a Generation) for
// its own draft→publish→send lifecycle + send tracking.
model Newsletter {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  subject String  @default("") // email subject / archive title
  preview String? // short teaser / email preheader
  body    String  @default("") @db.Text // LEGACY plain-text body; superseded by `blocks`
  blocks  Json?   // ordered content blocks [{ id, type, props }]; null = legacy (use body)
  template Json?  // per-issue branding override (from a preset); null = campaign default
  model   String? // AI model used to draft, if any

  status      String    @default("draft") // draft | published
  publishedAt DateTime?

  // Phase 3 send tracking
  sentAt         DateTime?
  recipientCount Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId, status])
  @@schema("engagecampaign")
}

// ─── Contacts / CRM ──────────────────────────────────────────────────────────

// The unified contact list for a campaign — donors, volunteers, supporters, and
// (later) matched voters, all in one place. Website volunteer signups flow in
// here as `source = "volunteer_signup"` contacts.
model Contact {
  id          String    @id @default(cuid())
  committeeId String
  committee   Committee @relation(fields: [committeeId], references: [id], onDelete: Cascade)

  firstName String
  lastName  String

  // A contact can hold several classifications at once (a supporter who is also
  // a donor). Values from CONTACT_TYPES (supporter|volunteer|donor|voter|prospect|other).
  types  String[] @default([])
  source String   @default("manual") // manual | volunteer_signup | import

  // Linked voter record (set via the "Find voter record" flow on the contact).
  // `stateVoterId` is the BOE statewide id (e.g. NY000000000009092569); `voterState`
  // says which state's voter file it belongs to (e.g. "ny"). Read from the voter
  // parquets — not a DB relation.
  stateVoterId String?
  voterState   String?

  // Committee-defined custom field values, keyed by ContactField id.
  customFields Json?

  emails      ContactEmail[]
  phones      ContactPhone[]
  addresses   ContactAddress[]
  contactNotes ContactNote[]
  volunteerSignups VolunteerSignup[]
  donations   ContactDonation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([committeeId])
  @@index([committeeId, lastName])
  @@schema("engagecampaign")
}

// Multiple labeled emails per contact (label required, e.g. "Personal", "Work").
// A confirmed campaign contribution matched to a contact (NY state disclosures or
// federal FEC), added via the "Find donations" review flow. A SNAPSHOT of the record
// — the source parquets have no stable per-row id for NY, so we store the details +
// a dedup `refKey` (fec = cycle:tranId; ny = filer|date|last|first|amount).
model ContactDonation {
  id           String   @id @default(cuid())
  contactId    String
  committeeId  String
  source       String // "ny" | "fec"
  refKey       String
  donorName    String?
  recipient    String?
  amount       Float?
  donationDate String? // "YYYY-MM-DD"
  cycle        Int? // FEC election cycle
  city         String?
  state        String?
  employer     String?
  occupation   String?
  createdAt    DateTime @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([contactId, source, refKey])
  @@index([contactId])
  @@schema("engagecampaign")
}

model ContactEmail {
  id        String  @id @default(cuid())
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  label     String
  email     String
  order     Int     @default(0)

  @@index([contactId])
  @@schema("engagecampaign")
}

// Multiple labeled phone numbers per contact (label required, e.g. "Mobile").
model ContactPhone {
  id        String  @id @default(cuid())
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  label     String
  phone     String
  order     Int     @default(0)

  @@index([contactId])
  @@schema("engagecampaign")
}

// Multiple labeled addresses per contact (label required, e.g. "Home", "Mailing",
// "Business"). lat/lng/placeId are populated when entered via Google Places.
model ContactAddress {
  id        String  @id @default(cuid())
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  label     String
  line1     String
  line2     String?
  city      String?
  state     String?
  zip       String?
  lat       Float?
  lng       Float?
  placeId   String? // Google Place ID, when selected from autocomplete
  order     Int     @default(0)

  @@index([contactId])
  @@schema("engagecampaign")
}

// A timestamped note in a contact's history (append-only log; newest first in UI).
model ContactNote {
  id        String   @id @default(cuid())
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  body      String   @db.Text
  createdAt DateTime @default(now())

  @@index([contactId])
  @@schema("engagecampaign")
}

// A pair of contacts a user marked "not a duplicate" — suppressed from the
// duplicates review. Stored with the lexicographically smaller id as aId so a
// pair is a single row. aId/bId are plain scalars (no FK): a merged-away id just
// stops matching, so stale rows are harmless.
model ContactMergeDismissal {
  committeeId String
  aId         String
  bId         String
  createdAt   DateTime @default(now())

  @@id([aId, bId])
  @@index([committeeId])
  @@schema("engagecampaign")
}

// A committee-defined custom contact field. `type` is a ContactFieldType code
// (see lib/contactFields.ts); `options` holds the choice list for select/
// multiselect. Values live in Contact.customFields JSON, keyed by this id.
model ContactField {
  id          String   @id @default(cuid())
  committeeId String
  label       String
  type        String
  options     Json?
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([committeeId])
  @@schema("engagecampaign")
}

// A committee-defined custom contact tag (on top of the fixed built-in tags in
// lib/tags.ts). `slug` is what's stored in Contact.types; label + color drive the
// UI. committeeId is a plain scalar (no FK), matching the other contact-aux tables.
model CommitteeTag {
  id          String   @id @default(cuid())
  committeeId String
  slug        String
  label       String
  color       String
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  @@unique([committeeId, slug])
  @@index([committeeId])
  @@schema("engagecampaign")
}

// A named, committee-shared advanced contact search. `query` is the serialized
// SearchQuery (groups of conditions) from lib/contactsSearch. committeeId /
// createdById are plain scalars (no FK) to keep this self-contained.
model ContactSavedSearch {
  id          String   @id @default(cuid())
  committeeId String
  name        String
  query       Json
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([committeeId])
  @@schema("engagecampaign")
}

