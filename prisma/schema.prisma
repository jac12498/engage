// EngageCampaign data layer.
//
// IMPORTANT: every model is bound to the `engagecampaign` Postgres schema via
// `@@schema`. This app shares the Supabase database with the existing Engage app
// (version10.3, which owns `public`), so isolation is the safety boundary —
// EngageCampaign's Prisma never references or migrates anything in `public`.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["engagecampaign"]
}

// ─── NextAuth ────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  campaign      Campaign?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@schema("engagecampaign")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@schema("engagecampaign")
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("engagecampaign")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@schema("engagecampaign")
}

// ─── Campaign profile + entitlement ──────────────────────────────────────────

model Campaign {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Candidate / office profile (powers AI Communications + Candidate Website)
  candidateName String
  office        String
  party         String? // primary ballot line (required in the UI); null only on legacy rows
  additionalParties String[] @default([]) // fusion endorsements, e.g. ["Working Families"] alongside a Democratic primary line
  committeeName String? // registered campaign committee, e.g. "Friends of Jane Candidate" — powers the legal "Paid for by" disclaimer (required in the UI)

  // Physical postal address — required in every newsletter footer (CAN-SPAM). Stored as
  // standard US components; `mailingAddress` is the deprecated free-text field (unused).
  mailingAddress String?
  mailingStreet  String?
  mailingStreet2 String?
  mailingCity    String?
  mailingState   String?
  mailingZip     String?

  // Campaign-level newsletter template (shared header/footer/theme across all issues).
  // Shape: { theme, header, footer } — see lib/newsletter/template.ts. Null = defaults.
  newsletterTemplate Json?

  // Candidate headshot — the candidate's photo, stored in-DB. Lives on Campaign (not
  // Website) so it's part of the profile and available before any site exists. Served
  // via /api/website/headshot/[campaignId].
  headshotData Bytes?
  headshotMime String?

  bio           String? @db.Text
  tagline       String?
  website       String?

  // Candidate knowledge — gathered via the guided interview. The richer this is,
  // the better-grounded every generated communication (and, later, the website).
  education          String? @db.Text
  experience         String? @db.Text
  whyRunning         String? @db.Text
  coreValues         String? @db.Text
  politicalLean      String? @db.Text // short narrative summary of the candidate's lean/positions
  voiceTone          String? // preferred tone, e.g. "warm and plainspoken"
  interview          Json? // raw structured interview answers (e.g. the lean questionnaire)
  interviewUpdatedAt DateTime?

  // District link — the bridge to voter records. We reuse the shared district
  // hierarchy that the existing app owns in `public.districts` (read-only). On
  // onboarding we snapshot the chosen district so voter-universe queries never
  // need a cross-schema join: `districtQueryString` is the URL-encoded
  // field=value filter (| = OR) that selects this district's voters from the
  // voter parquet via DuckDB, exactly as version10.3 does.
  state              String? // 2-letter or full state name; drives coverage gating (see lib/coverage)
  district           String? // human-readable district name (e.g. "Ulster County Legislature District 23")
  districtId         String? // UUID of the public.districts row chosen at onboarding
  districtQueryString String? // snapshot of districts.query_string → voter-file filter
  districtVoterCount  Int? // snapshot of districts.voter_count at selection time

  // Entitlement: which plan this account is on. Default free tier = Starter.
  plan String @default("starter") // starter | campaign | committee

  // AI Communications
  aiModel            String? // preferred generation model (any plan can select); null = default Haiku
  creditsThisMonth   Int      @default(0) @map("generationsThisMonth") // Model Credits consumed this month
  revisionsThisMonth Int      @default(0) // every 5th revision charges the model's credit cost
  crawlsThisMonth    Int      @default(0) // website-crawl references this month
  websiteEditsThisMonth Int   @default(0) // conversational website-builder messages this month
  newsSearchesThisMonth Int   @default(0) // "In the News" web-search discovery runs this month
  newsletterEmailsThisMonth Int @default(0) // newsletter recipient-emails sent this month (send metering)
  billingPeriodStart   DateTime @default(now())

  topics       Topic[]
  generations  Generation[]
  contextItems ContextItem[]
  site         Website?
  contacts     Contact[]
  tags         Tag[]
  newsClips    NewsClip[]
  newsletterSubscribers NewsletterSubscriber[]
  newsletters  Newsletter[]
  newsletterImages NewsletterImage[]
  newsletterPresets NewsletterPreset[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("engagecampaign")
}

// ─── AI Communications ───────────────────────────────────────────────────────

// A saved AI-generated communication. Ported from the archived Amplify app and
// extended with `model` (which AI model produced it) and `newsItemId` (the news
// item used to ground it, if any).
model Generation {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  // Content format (e.g. speech, email, social_facebook, press_release …) and
  // the medium it belongs to (speeches | letters | social | print).
  type       String
  medium     String? // grouping for the media sub-pages
  title      String?
  topicId    String? // optional Topic this piece is about
  topic      Topic?  @relation(fields: [topicId], references: [id], onDelete: SetNull)
  issueId    String? // optional Issue used as the topic
  newsItemId String? // optional NewsItem used as grounding
  newsHook   String? // freeform topic / hook when no Topic is selected
  model      String // AI model used, e.g. claude-haiku-4-5
  prompt     String  @db.Text
  content    String  @db.Text // current (latest) version's content
  published  Boolean @default(false)

  versions GenerationVersion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId])
  @@index([topicId])
  @@schema("engagecampaign")
}

// One version in a generation's refine history. v1 = the original draft
// (revisionNote null); each subsequent version records the note that produced
// it, so the human↔AI collaboration is captured and browsable.
model GenerationVersion {
  id           String     @id @default(cuid())
  generationId String
  generation   Generation @relation(fields: [generationId], references: [id], onDelete: Cascade)
  versionNo    Int
  content      String     @db.Text
  revisionNote String?    @db.Text
  model        String
  createdAt    DateTime   @default(now())

  @@index([generationId])
  @@schema("engagecampaign")
}

// A "hot topic" — a specific subject to communicate about. Mirrors v10.3's
// CommunicationsTopic: a key message + audience + occasion + talking points that
// a generation targets (distinct from the candidate's standing Issue positions).
model Topic {
  id             String       @id @default(cuid())
  campaignId     String
  campaign       Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  title          String
  keyMessage     String?       @db.Text
  targetAudience String?
  occasion       String?
  talkingPoints  String[] // ordered by priority (most → least important)
  generations    Generation[]
  contextItems   ContextItem[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([campaignId])
  @@schema("engagecampaign")
}

// Every piece of grounding is a ContextItem. Two orthogonal dimensions:
//   type  — "note" (plain background) | "position" (stance + keyPoints) |
//           "reference" (press/article with url + source)
//   scope — topicId null → GENERAL (every generation); topicId set → only when
//           that Topic is used (mirrors v10.3's CampaignIntelligence.commTopicId).
// Auto-injected by scope: general items + the selected topic's items.
model ContextItem {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  topicId    String?
  topic      Topic?   @relation(fields: [topicId], references: [id], onDelete: Cascade)

  type      String   @default("note")
  title     String? // position: issue name; reference: headline; note: optional label
  body      String   @db.Text // position: the stance; reference: summary; note: the text
  keyPoints String[] // positions only (ordered talking points)
  url       String? // references only
  source    String? // references only
  refType   String? // references only: "webpage" | "document" (PDF)
  order     Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId])
  @@index([topicId])
  @@schema("engagecampaign")
}

// ─── Candidate Website ───────────────────────────────────────────────────────

// One published-or-draft website per campaign. Content is auto-drafted from the
// campaign profile (bio, why-running, values, positions, topics) via Claude,
// then editable. Served publicly at /c/<slug> when `published`.
model Website {
  id         String   @id @default(cuid())
  campaignId String   @unique
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  slug      String  @unique // public path segment: /c/<slug>
  published Boolean @default(false)

  // Theme
  primaryColor String  @default("#1b3a6b")
  accentColor  String  @default("#c4910a")
  fontTheme    String  @default("classic") // named preset: classic | modern | serif
  headshotData Bytes?  // uploaded candidate photo, stored in-DB (served via /api/website/headshot/[campaignId])
  headshotMime String? // content-type of the uploaded photo, e.g. image/png — null = no headshot

  // Calls to action
  donateUrl    String? // external ActBlue / WinRed / Anedot link (no payment processing here)
  contactEmail String?

  pages   Page[]
  signups VolunteerSignup[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("engagecampaign")
}

// ─── Page/Block content model (Phase 1) ──────────────────────────────────────
// A Website has many Pages; a Page has an ordered list of Blocks. Each Block is
// one of a closed vocabulary of types (see src/lib/website/blocks.ts) with a
// validated `props` JSON payload. Rendering, the editor palette, and the Phase 2
// AI builder all read that single block registry. See docs/website-phase1-spec.md.
model Page {
  id        String  @id @default(cuid())
  websiteId String
  website   Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  slug      String // path segment; the isHome page is served at the site root. Unique per website.
  title     String // nav label + <title>
  navOrder  Int     @default(0)
  showInNav Boolean @default(true)
  published Boolean @default(true) // draft a page without unpublishing the whole site
  isHome    Boolean @default(false) // exactly one per site; undeletable; served at root

  blocks Block[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([websiteId, slug])
  @@index([websiteId])
  @@schema("engagecampaign")
}

model Block {
  id     String @id @default(cuid())
  pageId String
  page   Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)

  type  String // one of the v1 vocabulary; validated on write
  order Int    @default(0)
  props Json   // typed, validated per-type payload (BLOCK_SPECS[type].validate)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pageId])
  @@schema("engagecampaign")
}

// Raw intake from the public website volunteer form. Acts as a moderation queue:
// signups arrive `pending`, then a reviewer Accepts (promotes to a Contact) or
// Rejects. Kept separate from Contact so unauthenticated/spam input never lands
// directly in the CRM.
model VolunteerSignup {
  id        String  @id @default(cuid())
  websiteId String
  website   Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  name      String
  email     String
  phone     String?
  message   String? @db.Text
  createdAt DateTime @default(now())

  // Review workflow
  status     String    @default("pending") // pending | accepted | rejected
  reviewedAt DateTime?
  contactId  String? // the Contact created/linked when accepted
  contact    Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([websiteId])
  @@index([websiteId, status])
  @@index([contactId])
  @@schema("engagecampaign")
}

// Press coverage ("In the News") about the candidate. Discovered via Claude web
// search — or added by URL — then curated: clips arrive `pending`, and a reviewer
// Approves (surfaces on the site's `pressMentions` block) or Rejects. External
// articles are NEVER auto-published: the review step guards against false-positive
// (wrong person / same name) or off-message hits.
model NewsClip {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  headline    String
  url         String
  outlet      String? // publication name, when known
  summary     String?   @db.Text // 1–2 sentence blurb
  publishedAt DateTime? // article date, when known
  source      String    @default("web_search") // web_search | manual

  status     String    @default("pending") // pending | approved | rejected
  reviewedAt DateTime?

  createdAt DateTime @default(now())

  @@unique([campaignId, url]) // dedupe repeat discovery of the same article
  @@index([campaignId, status])
  @@schema("engagecampaign")
}

// ─── Newsletter ──────────────────────────────────────────────────────────────

// A subscriber to the campaign's periodic newsletter. Public signup uses double
// opt-in: a signup arrives `pending` with a confirmToken; clicking the emailed
// link flips it to `active`. Every subscriber carries a permanent unsubscribeToken
// used in the footer of each newsletter (CAN-SPAM one-click unsubscribe). Only
// `active` subscribers are mailed. Kept separate from Contact (a lightweight,
// compliance-bearing mailing list), though active subscribers may also be surfaced
// as Contacts later.
model NewsletterSubscriber {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  email  String
  name   String?
  status String @default("pending") // pending | active | unsubscribed
  source String @default("website")

  confirmToken     String? @unique // double opt-in; cleared once confirmed
  unsubscribeToken String  @unique // permanent; embedded in every send

  createdAt      DateTime  @default(now())
  confirmedAt    DateTime?
  unsubscribedAt DateTime?

  @@unique([campaignId, email])
  @@index([campaignId, status])
  @@schema("engagecampaign")
}

// An uploaded image used in a newsletter image block. Stored in-DB and served at a
// stable public URL (/api/newsletter/image/[id]) so email clients can fetch it.
model NewsletterImage {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  data       Bytes
  mime       String
  createdAt  DateTime @default(now())

  @@index([campaignId])
  @@schema("engagecampaign")
}

// A saved newsletter preset — a full starting point bundling branding (theme/
// header/footer) + a starting block layout. Users start a new issue from one, or
// "save as template" from any issue. Built-in presets live in lib/newsletter/presets.ts.
model NewsletterPreset {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  name     String
  template Json // branding: { theme, header, footer }
  blocks   Json // starting content blocks [{ id, type, props }]

  createdAt DateTime @default(now())

  @@index([campaignId])
  @@schema("engagecampaign")
}

// One issue of the campaign's newsletter. Authored (optionally AI-drafted) in the
// newsletter manager, published to the public archive, and — in Phase 3 — emailed to
// active subscribers. `body` is plain text (blank lines = paragraphs) so it renders
// safely in both the web archive and email. Dedicated model (not a Generation) for
// its own draft→publish→send lifecycle + send tracking.
model Newsletter {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  subject String  @default("") // email subject / archive title
  preview String? // short teaser / email preheader
  body    String  @default("") @db.Text // LEGACY plain-text body; superseded by `blocks`
  blocks  Json?   // ordered content blocks [{ id, type, props }]; null = legacy (use body)
  template Json?  // per-issue branding override (from a preset); null = campaign default
  model   String? // AI model used to draft, if any

  status      String    @default("draft") // draft | published
  publishedAt DateTime?

  // Phase 3 send tracking
  sentAt         DateTime?
  recipientCount Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId, status])
  @@schema("engagecampaign")
}

// ─── Contacts / CRM ──────────────────────────────────────────────────────────

// The unified contact list for a campaign — donors, volunteers, supporters, and
// (later) matched voters, all in one place. Website volunteer signups flow in
// here as `source = "volunteer_signup"` contacts.
model Contact {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  firstName String
  lastName  String

  // A contact can hold several classifications at once (a supporter who is also
  // a donor). Values from CONTACT_TYPES (supporter|volunteer|donor|voter|prospect|other).
  types  String[] @default([])
  source String   @default("manual") // manual | volunteer_signup | import

  emails      ContactEmail[]
  phones      ContactPhone[]
  addresses   ContactAddress[]
  contactNotes ContactNote[]
  contactTags ContactTag[]
  volunteerSignups VolunteerSignup[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId])
  @@index([campaignId, lastName])
  @@schema("engagecampaign")
}

// Multiple labeled emails per contact (label required, e.g. "Personal", "Work").
model ContactEmail {
  id        String  @id @default(cuid())
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  label     String
  email     String
  order     Int     @default(0)

  @@index([contactId])
  @@schema("engagecampaign")
}

// Multiple labeled phone numbers per contact (label required, e.g. "Mobile").
model ContactPhone {
  id        String  @id @default(cuid())
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  label     String
  phone     String
  order     Int     @default(0)

  @@index([contactId])
  @@schema("engagecampaign")
}

// Multiple labeled addresses per contact (label required, e.g. "Home", "Mailing",
// "Business"). lat/lng/placeId are populated when entered via Google Places.
model ContactAddress {
  id        String  @id @default(cuid())
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  label     String
  line1     String
  line2     String?
  city      String?
  state     String?
  zip       String?
  lat       Float?
  lng       Float?
  placeId   String? // Google Place ID, when selected from autocomplete
  order     Int     @default(0)

  @@index([contactId])
  @@schema("engagecampaign")
}

// A timestamped note in a contact's history (append-only log; newest first in UI).
model ContactNote {
  id        String   @id @default(cuid())
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  body      String   @db.Text
  createdAt DateTime @default(now())

  @@index([contactId])
  @@schema("engagecampaign")
}

// User-defined tags, scoped to a campaign. Reused across contacts (m:n via ContactTag).
model Tag {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  name       String
  createdAt  DateTime @default(now())

  contactTags ContactTag[]

  @@unique([campaignId, name])
  @@index([campaignId])
  @@schema("engagecampaign")
}

// Join table linking contacts to tags.
model ContactTag {
  contactId String
  tagId     String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
  @@index([tagId])
  @@schema("engagecampaign")
}
