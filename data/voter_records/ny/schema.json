  "voterIdFormat": {
    "type": "prefixed_numeric",
    "statePrefix": "NY",
    "format": "NY000000000000000000",
    "length": 20,
    "example": "NY000000000034684935",
    "description": "NY state prefix followed by 18-digit zero-padded voter ID",
    "uniqueAcrossStates": true,
    "notes": [
      "Voter IDs are globally unique due to state prefix",
      "Numeric portion is zero-padded to 18 digits",
      "Total length is always 20 characters"
    ]
  },
  
  "notes": [
    "NY State BOE does not provide phone numbers or email addresses in the voter file",
    "Date fields are typically in YYYYMMDD format without separators",
    "Some counties may have additional columns at the end - these are county-specific",
    "Empty/null values are typically represented as empty strings between commas",
    "prismaFieldMapping maps Prisma Voter model fields (camelCase) to Parquet columns (snake_case)"
  ]
